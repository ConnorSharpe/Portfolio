---
const categories = [
  {
    name: 'AI & Agentic Systems',
    color: 'accent-warm',
    skills: [
      'Multi-Agent Orchestration',
      'LLM Governance & Guardrails',
      'Drift Detection',
      'Prompt Engineering',
      'LLM Behavioral Evaluation',
      'Event-Driven Agent Architecture',
      'RAG / Hybrid Retrieval (pgvector)',
      'MCP Knowledge Graphs',
      'Agent Guardrails via Hooks',
      'Claude',
      'ChatGPT',
      'Grok',
      'Copilot',
    ],
  },
  {
    name: 'Frontend',
    color: 'accent',
    skills: ['TypeScript', 'React', 'Vue.js', 'Next.js', 'Angular', 'JavaScript', 'HTML5', 'CSS3'],
  },
  {
    name: 'Backend',
    color: 'accent',
    skills: ['C# / .NET', 'Node.js / Express', 'Python', 'SQL', 'REST API Design'],
  },
  {
    name: 'Testing & Evaluation',
    color: 'accent-warm',
    skills: [
      'Test-Driven Development',
      'Unit & Integration Testing',
      'LLM Behavioral Testing',
      'Retrieval & Agent Eval Harnesses',
      'Compliance-Focused Test Environments',
      'CI/CD Pipeline Validation',
    ],
  },
  {
    name: 'Tooling & DevOps',
    color: 'accent',
    skills: ['GitHub', 'Vercel', 'Octopus Deploy', 'Agile / Scrum', 'JIRA', 'OWASP', 'Production Observability'],
  },
  {
    name: 'Communication',
    color: 'accent',
    skills: ['Technical Specification Writing', 'Code Review Leadership', 'Cross-Functional Communication'],
  },
];

// Map color strings to Tailwind classes (Tailwind needs whole class names to purge correctly)
const colorMap: Record<string, { heading: string; pill: string }> = {
  accent: {
    heading: 'text-accent',
    pill: 'bg-accent/10 text-accent border-accent/20',
  },
  'accent-warm': {
    heading: 'text-accent-warm',
    pill: 'bg-accent-warm/10 text-accent-warm border-accent-warm/20',
  },
};
---

<section id="skills" class="py-24 px-4 sm:px-6 border-t border-border">
  <div class="max-w-6xl mx-auto">
    <p class="font-mono text-accent text-sm mb-3 tracking-widest uppercase">Skills</p>
    <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-12">
      What I work with.
    </h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        categories.map(({ name, color, skills }) => {
          const { heading, pill } = colorMap[color];
          return (
            <div>
              <h3 class={`font-mono text-sm font-semibold mb-4 tracking-wide ${heading}`}>
                {name}
              </h3>
              <div class="flex flex-wrap gap-2">
                {skills.map((skill) => (
                  <span class={`text-xs font-medium px-3 py-1 rounded-full border ${pill}`}>
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
