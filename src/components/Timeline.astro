---
const jobs = [
  {
    company: 'Fillory AI',
    title: 'AI Software Engineer',
    dates: 'Nov 2025 – Apr 2026',
    location: 'Portland, OR',
    bullets: [
      'Architected a distributed AI development platform spanning multi-machine production infrastructure, a cloud code execution sandbox, and a GitHub-based deployment pipeline.',
      'Built an LLM governance and guardrails middleware layer covering memory management, drift detection, and identity coherence across multiple live AI-powered applications.',
      'Designed event-driven architecture for an AI middleware platform (Portland Protocol), including a phase-gated event system with architect review gates, versioned event envelopes, and a retryable webhook delivery pipeline.',
      'Implemented semantic action normalization and hardened task state tracking in an agent system built with TypeScript and Next.js; diagnosed and resolved planner behavior regressions.',
      'Built process persistence and boot automation for a 17-service AI platform, replacing a manual power-cycle recovery that had previously taken 6 hours and allowing an unplanned hardware move with no data loss.',
      'Designed and executed LLM behavioral evaluation suites to detect agent sycophancy and drift; authored technical specifications governing AI system architecture and compliance.',
    ],
    tech: ['TypeScript', 'Next.js', 'Claude API', 'ChatGPT', 'Grok', 'Python', 'CI/CD'],
    monogram: 'FA',
  },
  {
    company: 'Office Ally',
    title: 'Software Developer',
    dates: 'Jan 2022 – Nov 2024',
    location: 'Vancouver, WA',
    bullets: [
      'Served as technical lead for an offshore Angular development team, conducting code reviews and enforcing maintainable, secure, and standards-compliant front-end delivery.',
      'Built and validated .NET API endpoints, improving platform reliability and scalability through a structured CI/CD release workflow.',
      'Rebuilt the account signup flow to simplify onboarding; implemented ReCaptcha and updated encryption practices aligned with OWASP standards.',
      'Improved deployment processes using Octopus Deploy and built a UTC time zone converter to resolve data localization issues.',
      'Translated a legacy Visual Basic (2003) interface into a modern Vue.js front end, significantly improving maintainability and user experience.',
    ],
    tech: ['Angular', 'Vue.js', 'C#', '.NET', 'SQL', 'CI/CD', 'Octopus Deploy', 'OWASP'],
    monogram: 'OA',
  },
  {
    company: 'Prosper IT Consulting',
    title: 'Software Developer',
    dates: 'Feb 2020 – Dec 2021',
    location: 'Portland, OR',
    bullets: [
      'Redesigned the full user experience for learncodinganywhere.com, including registration, navigation, progress tracking, and dark mode.',
      'Built dynamic progress bars, a notification system, and a drill-completion locking system for student course management.',
      'Created role-based subscription and free course services to support tiered access for new and existing users.',
    ],
    tech: ['C#', '.NET MVC', 'JavaScript', 'jQuery', 'Bootstrap', 'SQL'],
    monogram: 'PI',
  },
];
---

<section id="experience" class="py-24 px-4 sm:px-6 border-t border-border">
  <div class="max-w-4xl mx-auto">
    <p class="font-mono text-accent text-sm mb-3 tracking-widest uppercase">Experience</p>
    <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-16">
      Where I've worked.
    </h2>

    <div class="relative">
      <!-- Vertical line -->
      <div
        class="absolute left-5 md:left-8 top-0 bottom-0 w-px bg-border"
        aria-hidden="true"
      >
      </div>

      <div class="flex flex-col gap-10">
        {
          jobs.map((job) => (
            <div class="relative flex gap-6 md:gap-10">
              {/* Dot */}
              <div class="shrink-0 relative z-10">
                <div class="w-10 h-10 md:w-16 md:h-16 rounded-full bg-surface border-2 border-accent flex items-center justify-center font-bold text-accent text-xs md:text-sm">
                  {job.monogram}
                </div>
              </div>

              {/* Card */}
              <div class="flex-1 bg-surface border border-border rounded-xl p-6 card-hover mb-2">
                {/* Header */}
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-4">
                  <div>
                    <div class="font-mono text-xs text-accent mb-1 tracking-wide">
                      {job.company}
                    </div>
                    <h3 class="text-lg font-bold text-text-primary leading-snug">
                      {job.title}
                    </h3>
                  </div>
                  <div class="text-right shrink-0">
                    <div class="text-sm text-text-muted">{job.dates}</div>
                    <div class="text-xs text-text-muted">{job.location}</div>
                  </div>
                </div>

                {/* Bullets */}
                <ul class="space-y-2 mb-4">
                  {job.bullets.map((bullet) => (
                    <li class="flex gap-2 text-sm text-text-muted leading-relaxed">
                      <span class="text-accent mt-1 shrink-0" aria-hidden="true">›</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                {/* Tech pills */}
                <div class="flex flex-wrap gap-2 pt-4 border-t border-border">
                  {job.tech.map((t) => (
                    <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-bg border border-border text-text-muted">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
